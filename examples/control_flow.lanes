// selection, iteration and functions
//
// run with: make run examples/control_flow.lanes

// functions can call themselves
function factorial(n: integer) -> integer {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

// if / else if / else
function sign(x: integer) -> integer {
    if x > 0 {
        return 1;
    } else if x < 0 {
        return -1;
    } else {
        return 0;
    }
}

// a function with no result returns void
function countdown(from: integer) -> void {
    let i = from;
    while i > 0 {
        print(i);
        i = i - 1;
    }
}

function main() -> integer {
    // for (i in start, end) counts from start up to, but not including, end
    for (i in 1, 6) {
        print(factorial(i));
    }

    print(sign(-7));
    print(sign(0));

    countdown(3);
    return 0;
}
